{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-dict",
  "version": "1.0.1",
  "identifier": "com.aidict.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI-dict",
        "width": 940,
        "height": 600,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "popup",
        "title": "AI-dict",
        "width": 468,
        "height": 608,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
