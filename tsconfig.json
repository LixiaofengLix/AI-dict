{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* ES2022：原句分句用 Intl.Segmenter（features/sentence/splitWords），类型在这个 lib 里 */
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* 测试里要用 node:fs / node:sqlite，显式声明才载入 @types/node */
    "types": ["node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
